{
  "name": "parking_partner",
  "version": "1.0.0",
  "description": "Modern Parking Partner Platform - Discover, Reserve, Pay & Park",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/index.ts",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
